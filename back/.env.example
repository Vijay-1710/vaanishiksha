# Database (matches docker-compose.yml credentials; Docker Postgres uses host port 5433)
DATABASE_URL=postgresql://eduuser:edupass123@localhost:5433/eduplat

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage (use local for dev, S3 for production)
STORAGE_TYPE=local
STORAGE_PATH=./storage
# S3_BUCKET=your-bucket
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret

# API Keys (add your keys here)
# GEMINI_API_KEY is an Omniroute unified key (format: omnikey-g-... or sk-...)
# for translation via the Omniroute local gateway. NOT a raw Google Gemini key.
# GEMINI_API_KEY=your-omniroute-key

# HuggingFace token - REQUIRED for IndicTrans2 (gated repos).
# Get one at https://huggingface.co/settings/tokens after accepting
# AI4Bharat's terms on the model pages. Without it, translation falls
# back to the LLM (Omniroute) path automatically.
# HF_TOKEN=hf_xxxxx

# JWT
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Application
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
